{
  "name": "minijuegos-entrenador-bots",
  "version": "3.0.0",
  "description": "Plataforma de minijuegos para entrenamiento cognitivo",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:sw",
    "build:sw": "tsc -p tsconfig.sw.json --outDir dist --noEmit false",
    "build:e2e": "node ./e2e/build-for-e2e.mjs",
    "preview": "vite preview",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "type-check-watch": "tsc --noEmit --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:load": "k6 run load-test/load-test.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.8.0",
    "@playwright/test": "^1.40.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20.10.0",
    "@vitest/ui": "^4.1.9",
    "jsdom": "^29.1.1",
    "terser": "^5.48.0",
    "typescript": "^5.3.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "games",
    "cognitive-training",
    "minigames"
  ],
  "author": "empalsa",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7"
  }
}
